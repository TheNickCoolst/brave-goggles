$boost=3,site=ai.stackexchange.com
$boost=3,site=stackoverflow.com
$boost=3,site=substack.com,inurl=ai


# ======================================================================
# 9. GENERIC CATCH-ALL BOOSTS (AI content anywhere)
# ======================================================================
$boost=2,inurl=arxiv
$boost=2,intitle=transformer
$boost=2,intitle=diffusion-model
$boost=2,intitle=neural-network
$boost=2,intitle=fine-tuning
$boost=1,inurl=machine-learning
$boost=1,inurl=deep-learning
$boost=1,inurl=large-language-model


# ======================================================================
# 10. DOWNRANK - SEO SPAM, CONTENT FARMS, LISTICLES
# ======================================================================
$downrank=9,intitle=best-ai-tools
$downrank=9,intitle=top-10-ai
$downrank=9,intitle=top-ai-tools
$downrank=8,inurl=best-ai
$downrank=7,site=geeksforgeeks.org
$downrank=7,site=analyticsvidhya.com
