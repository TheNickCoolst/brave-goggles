! name: AI Focus
! description: Reranks Brave Search toward primary AI/ML sources - research papers, frontier labs, model hubs, agent frameworks, docs and quality news. Buries SEO spam and listicles.
! public: true
! author: nick
! avatar: #6b4fbb
! homepage: https://github.com/TheNickCoolst/brave-goggles

! ======================================================================
! AI FOCUS GOGGLE  -  v3  (2026-05)
! Reranks Brave Search results toward primary AI/ML sources.
! Syntax: https://github.com/brave/goggles-quickstart
!   $boost=N        raise ranking   (1-10)
!   $downrank=N     lower ranking   (1-10)
!   $discard        remove result
!   site=domain     limit to a site
!   /path           plain pattern, matches inside the URL
! Note: Goggles only REORDER Brave's index. They add no new pages.
! ======================================================================


! ===== 1. RESEARCH PAPERS & PREPRINTS =================================
$boost=10,site=arxiv.org
$boost=9,site=paperswithcode.com
$boost=8,site=openreview.net
/papers$boost=8,site=huggingface.co
$boost=7,site=semanticscholar.org
$boost=7,site=aclanthology.org
$boost=6,site=distill.pub
$boost=6,site=jmlr.org
$boost=6,site=proceedings.mlr.press
$boost=6,site=proceedings.neurips.cc
$boost=5,site=ar5iv.labs.arxiv.org
$boost=5,site=connectedpapers.com
$boost=5,site=scholar.google.com
/articles$boost=5,site=nature.com
$boost=4,site=biorxiv.org
$boost=4,site=ssrn.com


