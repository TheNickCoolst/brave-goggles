! name: AI Focus
! description: Re-ranks Brave Search toward primary AI/ML sources - research, labs, model hubs, agent frameworks, docs and quality news. Buries SEO spam and listicles. Updated 2026.
! public: true
! author: nick
! avatar: #6b4fbb
! homepage: https://github.com/brave/goggles-quickstart

# ======================================================================
# AI FOCUS GOGGLE  -  v2  (2026-05)
# Re-ranks Brave Search results toward primary AI/ML sources.
#
# Syntax: https://github.com/brave/goggles-quickstart
#   $boost=N      raise ranking      (1-10, higher = stronger)
#   $downrank=N   lower ranking      (1-10)
#   $discard      remove from result
#   site=         exact site / subdomain
#   inurl=        substring in URL
#   intitle=      substring in page title
# Note: Goggles only RE-ORDER Brave's index. They add no new pages.
# ======================================================================


# ======================================================================
# 1. RESEARCH PAPERS & PREPRINTS
# ======================================================================
$boost=10,site=arxiv.org
$boost=9,site=paperswithcode.com
$boost=8,site=openreview.net
$boost=8,site=huggingface.co,inurl=papers
$boost=7,site=semanticscholar.org
$boost=7,site=aclanthology.org
$boost=6,site=distill.pub
$boost=6,site=jmlr.org
$boost=6,site=proceedings.mlr.press
$boost=6,site=proceedings.neurips.cc
$boost=5,site=ar5iv.labs.arxiv.org
$boost=5,site=connectedpapers.com
$boost=5,site=scholar.google.com
$boost=5,site=nature.com,inurl=articles
$boost=4,site=biorxiv.org
$boost=4,site=ssrn.com


# ======================================================================
