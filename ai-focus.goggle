$downrank=6,site=quora.com
$downrank=6,site=pinterest.com
$downrank=5,site=linkedin.com,inurl=pulse
$downrank=5,site=upwork.com
$downrank=5,site=fiverr.com
$downrank=5,site=coursera.org
$downrank=5,site=udemy.com


# ======================================================================
# 11. DISCARD - PURE JUNK & AI SLOP
# ======================================================================
$discard,intitle=ai-tools-2024
$discard,intitle=ai-tools-2025
$discard,intitle=ai-tools-2026
